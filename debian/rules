#!/usr/bin/make -f

# With more than one binary package pybuild no longer guesses a destination.
# Stage the common wheel once, then let the two .install manifests copy it.
export PYBUILD_DESTDIR=debian/tmp

%:
	# dh-python Provides dh-sequence-python3, but that's a virtual name --
	# nothing ever actually installs it, so debhelper's compat-13 auto
	# sequencing (which looks for the addon module genuinely present on
	# disk) never fires and dh_python3 is silently skipped, leaving
	# ${python3:Depends} unresolved. Request the addon explicitly.
	dh $@ --buildsystem=pybuild --with python3

override_dh_installsystemduser:
	dh_installsystemduser --no-enable -p idasen-companion
	dh_installsystemduser --no-enable -p idasen-companion-headless --name=idasen-companion

override_dh_install:
	dh_install
	# Both standalone packages receive the common Python package from the same
	# pybuild output. The headless flavor then drops the GUI boundary and its
	# GUI source; assertions turn future path/name drift into a failed build.
	rm -rf debian/idasen-companion-headless/usr/lib/python3*/dist-packages/idasen_companion/gui
	test -x debian/idasen-companion-headless/usr/bin/idasen-companion
	test -x debian/idasen-companion-headless/usr/bin/idasen-companiond
	test -z "$$(find debian/idasen-companion-headless/usr/lib/python3*/dist-packages/idasen_companion -maxdepth 1 -type d -name gui -print -quit)"

override_dh_auto_test:
	python3 -c "import PySide6.QtWidgets"
	# pybuild's own test runner copies tests/ and pyproject.toml next to
	# the built package and runs pytest from inside that copy. Much of
	# this suite reads sibling paths (scripts/, src/, debian/, packaging/)
	# relative to the real repository root, which that copy does not
	# have. Running pytest from the checked-out tree instead keeps every
	# path real; only the built package's location needs adding to
	# PYTHONPATH so it imports the same way pybuild's copy would have.
	PYTHONPATH=$$(echo .pybuild/cpython3_*/build) python3 -m pytest -q
