#: src/idasen_companion/gui/setup_wizard.py
msgctxt "setup.welcome"
msgid "Set up your desk"
msgstr "Configura tu escritorio"

#: src/idasen_companion/gui/setup_wizard.py
msgctxt "setup.welcome"
msgid ""
"This wizard connects Idasen Companion to your Idåsen desk.\n"
"\n"
"If you already paired the desk in your system's Bluetooth settings, it will "
"simply appear on the next page.\n"
"\n"
"Otherwise, put the desk in pairing mode first: press and hold the button on "
"the control box under the desktop (next to the paddle) until its light "
"starts flashing."
msgstr ""
"Este asistente conecta Idasen Companion con tu escritorio Idåsen.\n"
"\n"
"Si ya emparejaste el escritorio en la configuración Bluetooth de tu sistema, "
"simplemente aparecerá en la página siguiente.\n"
"\n"
"De lo contrario, pon primero el escritorio en modo de emparejamiento: mantén "
"pulsado el botón de la caja de control bajo el tablero (junto a la palanca) "
"hasta que su luz empiece a parpadear."

#: src/idasen_companion/gui/setup_wizard.py
msgctxt "setup.welcome"
msgid "Starting the background service…"
msgstr "Iniciando el servicio en segundo plano…"

#: src/idasen_companion/gui/setup_wizard.py
