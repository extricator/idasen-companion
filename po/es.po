#: src/idasen_companion/core/logmsg.py
#, python-format
msgctxt "activity-log.entry"
msgid " Next change after %(next_target)s of active time."
msgstr " Próximo cambio tras %(next_target)s de tiempo activo."

#: src/idasen_companion/core/logmsg.py
#, python-format
msgctxt "activity-log.entry"
msgid "Idasen Companion daemon %(version)s starting (config: %(config)s)"
msgstr ""
"Iniciando el servicio Idasen Companion %(version)s (configuración: "
"%(config)s)"

#: src/idasen_companion/core/logmsg.py
msgctxt "activity-log.entry"
msgid "Daemon stopping."
msgstr "Deteniendo el servicio."

#: src/idasen_companion/core/logmsg.py
#, python-format
msgctxt "activity-log.entry"
msgid ""
"First run: imported settings from idasen CLI config (mac=%(mac)s, "
"%(presets)s preset)"
msgid_plural ""
"First run: imported settings from idasen CLI config (mac=%(mac)s, "
"%(presets)s presets)"
msgstr[0] ""
"Primera ejecución: se importó la configuración de idasen CLI (mac=%(mac)s, "
"%(presets)s preajuste)"
msgstr[1] ""
"Primera ejecución: se importó la configuración de idasen CLI (mac=%(mac)s, "
"%(presets)s preajustes)"

#: src/idasen_companion/core/logmsg.py
msgctxt "activity-log.entry"
msgid ""
"No desk configured yet. Launch Idasen Companion to run the setup wizard; "
"automation is on hold until then."
msgstr ""
"Todavía no hay ningún escritorio configurado. Abre Idasen Companion para "
"ejecutar el asistente de configuración; la automatización queda en espera "
"hasta entonces."

#: src/idasen_companion/core/logmsg.py
#, python-format
msgctxt "activity-log.entry"
msgid "Setup: testing desk %(mac)s..."
msgstr "Configuración: probando el escritorio %(mac)s..."

#: src/idasen_companion/core/logmsg.py
#, python-format
msgctxt "activity-log.entry"
msgid "Desk configured: %(mac)s (height %(height)s)."
msgstr "Escritorio configurado: %(mac)s (altura %(height)s)."

#: src/idasen_companion/core/logmsg.py
msgctxt "activity-log.entry"
msgid "Desk configured; starting automation."
msgstr "Escritorio configurado; iniciando la automatización."

#: src/idasen_companion/core/logmsg.py
msgctxt "activity-log.entry"
msgid "Configuration reloaded."
msgstr "Configuración recargada."

#: src/idasen_companion/core/logmsg.py
#, python-format
msgctxt "activity-log.entry"
msgid "Config reload failed, keeping old config: %(error)s"
msgstr "Error al recargar la configuración, se mantiene la anterior: %(error)s"

#: src/idasen_companion/core/logmsg.py
msgctxt "activity-log.entry"
msgid "Desk MAC changed; reconnecting to new desk."
msgstr "La MAC del escritorio ha cambiado; reconectando al nuevo escritorio."

#: src/idasen_companion/core/logmsg.py
msgctxt "activity-log.entry"
msgid ""
"No idle-time provider is available on this desktop, so the app cannot tell "
"whether you are at the keyboard. Automation will move the desk on schedule "
"whether you are here or not; idle, lock and away detection are all "
"inoperative."
msgstr ""
"No hay ningún proveedor de tiempo de inactividad disponible en este "
"escritorio, así que la aplicación no puede saber si estás frente al teclado. "
"La automatización moverá el escritorio según lo previsto estés o no; la "
"detección de inactividad, bloqueo y ausencia no funciona."

#: src/idasen_companion/core/logmsg.py
#, python-format
msgctxt "activity-log.entry"
msgid "Now idle (%(idle_time)s idle time)"
msgstr "Ahora inactivo (%(idle_time)s de inactividad)"

#: src/idasen_companion/core/logmsg.py
msgctxt "activity-log.entry"
msgid "Activity detected after idle period; resetting timers."
msgstr ""
"Actividad detectada tras un periodo de inactividad; reiniciando los "
"temporizadores."

#: src/idasen_companion/core/logmsg.py
msgctxt "activity-log.entry"
msgid ""
"Activity detected after a brief interruption; keeping this cycle's progress."
msgstr ""
"Actividad detectada tras una breve interrupción; se conserva el progreso de "
"este ciclo."

#: src/idasen_companion/core/logmsg.py
msgctxt "activity-log.entry"
msgid ""
"Switched away to another session; automation paused and the desk released."
msgstr ""
"Has cambiado a otra sesión; automatización en pausa y escritorio liberado."

#: src/idasen_companion/core/logmsg.py
msgctxt "activity-log.entry"
msgid ""
"Back in your session; automation resumed with a fresh cycle; re-reading the "
"desk."
msgstr ""
"De vuelta en tu sesión; automatización reanudada con un ciclo nuevo; "
"releyendo el escritorio."

#: src/idasen_companion/core/logmsg.py
msgctxt "activity-log.entry"
msgid ""
"Back in your session; automation resumed where it left off; re-reading the "
"desk."
msgstr ""
"De vuelta en tu sesión; automatización reanudada donde se quedó; releyendo "
"el escritorio."

#: src/idasen_companion/core/logmsg.py
msgctxt "activity-log.entry"
msgid ""
"This account has no graphical session, so there is no desk to automate and "
"no way to tell whether anyone is at it: automation is on hold and the desk "
"is left to whoever is logged in. It still responds to explicit commands from "
"here."
msgstr ""
"Esta cuenta no tiene sesión gráfica, así que no hay escritorio que "
"automatizar ni forma de saber si hay alguien en él: la automatización queda "
"en espera y el escritorio se deja a quien haya iniciado sesión. Sigue "
"respondiendo a órdenes explícitas desde aquí."

#: src/idasen_companion/core/logmsg.py
msgctxt "activity-log.entry"
msgid ""
"Graphical session detected; automation is live again with a fresh cycle. Re-"
"reading the desk."
msgstr ""
"Sesión gráfica detectada; la automatización vuelve a estar activa con un "
"ciclo nuevo. Releyendo el escritorio."

#: src/idasen_companion/core/logmsg.py
msgctxt "activity-log.entry"
msgid ""
"Graphical session detected; automation is live again where it left off. Re-"
"reading the desk."
msgstr ""
"Sesión gráfica detectada; la automatización vuelve a estar activa donde se "
"quedó. Releyendo el escritorio."

#: src/idasen_companion/core/logmsg.py
msgctxt "activity-log.entry"
msgid "System is suspending."
msgstr "El sistema se está suspendiendo."

#: src/idasen_companion/core/logmsg.py
msgctxt "activity-log.entry"
msgid "Resumed from suspend; resetting timers."
msgstr "Reanudado tras la suspensión; reiniciando los temporizadores."

#: src/idasen_companion/core/logmsg.py
#, python-format
msgctxt "activity-log.entry"
msgid "Detected potential time jump (%(elapsed)s elapsed); resetting state."
msgstr ""
"Posible salto temporal detectado (%(elapsed)s transcurridos); reiniciando el "
"estado."

#: src/idasen_companion/core/logmsg.py
#, python-format
msgctxt "activity-log.entry"
msgid "The system clock moved backwards by %(elapsed)s; resetting state."
msgstr "El reloj del sistema retrocedió %(elapsed)s; reiniciando el estado."

#: src/idasen_companion/core/logmsg.py
msgctxt "activity-log.entry"
msgid ""
"The desk is not this session's to read right now; leaving it alone. Its "
"position will be read once it is."
msgstr ""
"Ahora mismo el escritorio no es de esta sesión para leerlo; se deja en paz. "
"Su posición se leerá cuando lo sea."

#: src/idasen_companion/core/logmsg.py
#, python-format
msgctxt "activity-log.entry"
msgid "Initial desk read failed: %(error)s"
msgstr "Error en la lectura inicial del escritorio: %(error)s"

#: src/idasen_companion/core/logmsg.py
msgctxt "activity-log.entry"
msgid ""
"Could not read the desk at startup; automation will adopt its real position "
"at the first sync that succeeds."
msgstr ""
"No se pudo leer el escritorio al arrancar; la automatización adoptará su "
"posición real en la primera sincronización que funcione."

#: src/idasen_companion/core/logmsg.py
#, python-format
msgctxt "activity-log.entry"
msgid ""
"Initial state: off-cycle (desk at %(height)s, not a sit/stand preset); "
"automation paused until it returns to sit or stand."
msgstr ""
"Estado inicial: fuera de ciclo (escritorio a %(height)s, no es un preajuste "
"de sentado/de pie); automatización en pausa hasta que vuelva a sentado o de "
"pie."

#: src/idasen_companion/core/logmsg.py
#, python-format
msgctxt "activity-log.entry"
msgid ""
"Initial state: %(state)s (height: %(height)s); automation is off, so the "
"desk will only move when you ask it to."
msgstr ""
"Estado inicial: %(state)s (altura: %(height)s); la automatización está "
"desactivada, así que el escritorio solo se moverá cuando se lo pidas."

#: src/idasen_companion/core/logmsg.py
#, python-format
msgctxt "activity-log.entry"
msgid "Initial state: %(state)s (height: %(height)s)."
msgstr "Estado inicial: %(state)s (altura: %(height)s)."

#: src/idasen_companion/core/logmsg.py
msgctxt "activity-log.entry"
msgid ""
"The cycle clock starts from now: time spent in this position before the "
"restart is not carried over."
msgstr ""
"El reloj del ciclo empieza desde ahora: el tiempo pasado en esta posición "
"antes del reinicio no se conserva."

#: src/idasen_companion/core/logmsg.py
#, python-format
msgctxt "activity-log.entry"
msgid "Skipped transition as requested; staying %(state)s."
msgstr "Cambio omitido como se pidió; se sigue %(state)s."

#: src/idasen_companion/core/logmsg.py
#, python-format
msgctxt "activity-log.entry"
msgid ""
"Desk position changed from '%(previous)s' to '%(current)s' (%(height)s). "
"Synchronizing."
msgstr ""
"La posición del escritorio ha cambiado de «%(previous)s» a «%(current)s» "
"(%(height)s). Sincronizando."

#: src/idasen_companion/core/logmsg.py
#, python-format
msgctxt "activity-log.entry"
msgid ""
"Desk moved off sit/stand (%(height)s); automation paused until it returns to "
"a preset."
msgstr ""
"El escritorio se ha movido fuera de sentado/de pie (%(height)s); "
"automatización en pausa hasta que vuelva a un preajuste."

#: src/idasen_companion/core/logmsg.py
#, python-format
msgctxt "activity-log.entry"
msgid "Desk back at %(current)s (%(height)s); automation resumed."
msgstr ""
"El escritorio vuelve a estar %(current)s (%(height)s); automatización "
"reanudada."

#: src/idasen_companion/core/logmsg.py
msgctxt "activity-log.entry"
msgid "Could not read desk height for state sync; keeping internal state."
msgstr ""
"No se pudo leer la altura del escritorio para sincronizar el estado; se "
"mantiene el estado interno."

#: src/idasen_companion/core/logmsg.py
#, python-format
msgctxt "activity-log.entry"
msgid ""
"Move to %(intended)s failed: the desk did not respond and its height could "
"not be read. Staying %(previous)s."
msgstr ""
"Error al mover el escritorio a «%(intended)s»: no respondió y no se pudo "
"leer su altura. Se sigue %(previous)s."

#: src/idasen_companion/core/logmsg.py
msgctxt "activity-log.entry"
msgid " Will try again next cycle."
msgstr " Se reintentará en el próximo ciclo."

#: src/idasen_companion/core/logmsg.py
#, python-format
msgctxt "activity-log.entry"
msgid ""
"Move to %(intended)s failed: the desk did not respond and its height could "
"not be read (%(reason)s). Staying %(previous)s."
msgstr ""
"Error al mover el escritorio a «%(intended)s»: no respondió y no se pudo "
"leer su altura (%(reason)s). Se sigue %(previous)s."

#: src/idasen_companion/core/logmsg.py
#, python-format
msgctxt "activity-log.entry"
msgid ""
"A change is due, but the desk stayed put: no input for %(idle_time)s and "
"moves need input within %(threshold)s. It will move once you're back."
msgstr ""
"Toca un cambio, pero el escritorio no se movió: no hay actividad desde hace "
"%(idle_time)s y los movimientos requieren actividad en %(threshold)s. Se "
"moverá cuando vuelvas."

#: src/idasen_companion/core/logmsg.py
#, python-format
msgctxt "activity-log.entry"
msgid "Transition %(previous)s -> %(result)s completed (height %(height)s)."
msgstr ""
"Cambio de «%(previous)s» a «%(result)s» completado (altura %(height)s)."

#: src/idasen_companion/core/logmsg.py
#, python-format
msgctxt "activity-log.entry"
msgid ""
"Movement to %(intended)s interrupted (height %(height)s); returned to start, "
"now %(result)s."
msgstr ""
"Movimiento a «%(intended)s» interrumpido (altura %(height)s); se ha vuelto "
"al inicio, ahora %(result)s."

#: src/idasen_companion/core/logmsg.py
#, python-format
msgctxt "activity-log.entry"
msgid ""
"Movement to %(intended)s interrupted; moved toward it again (height "
"%(height)s), now %(result)s."
msgstr ""
"Movimiento a «%(intended)s» interrumpido; se ha vuelto a mover hacia esa "
"posición (altura %(height)s), ahora %(result)s."

#: src/idasen_companion/core/logmsg.py
#, python-format
msgctxt "activity-log.entry"
msgid ""
"Movement to %(intended)s interrupted (height %(height)s); left at %(result)s."
msgstr ""
"Movimiento a «%(intended)s» interrumpido (altura %(height)s); se ha dejado "
"en %(result)s."

#: src/idasen_companion/core/logmsg.py
msgctxt "activity-log.entry"
msgid "Automation turned on."
msgstr "Automatización activada."

#: src/idasen_companion/core/logmsg.py
msgctxt "activity-log.entry"
msgid "Automation turned off; manual control only."
msgstr "Automatización desactivada; solo control manual."

#: src/idasen_companion/core/logmsg.py
msgctxt "activity-log.entry"
msgid "Automation paused."
msgstr "Automatización en pausa."

#: src/idasen_companion/core/logmsg.py
msgctxt "activity-log.entry"
msgid "Automation resumed."
msgstr "Automatización reanudada."

#: src/idasen_companion/core/logmsg.py
msgctxt "activity-log.entry"
msgid "Next transition will be skipped."
msgstr "Se omitirá el próximo cambio."

#: src/idasen_companion/core/logmsg.py
#, python-format
msgctxt "activity-log.entry"
msgid "Snoozed for %(duration)s."
msgstr "Pospuesto durante %(duration)s."

#: src/idasen_companion/core/logmsg.py
#, python-format
msgctxt "activity-log.entry"
msgid "Manual move to %(target)s."
msgstr "Movimiento manual a %(target)s."

#: src/idasen_companion/core/logmsg.py
#, python-format
msgctxt "activity-log.entry"
msgid "Manual move to %(target)s failed."
msgstr "Error en el movimiento manual a %(target)s."

#: src/idasen_companion/core/logmsg.py
#, python-format
msgctxt "activity-log.entry"
msgid "Manual move to %(target)s failed: %(reason)s."
msgstr "Error en el movimiento manual a %(target)s: %(reason)s."

#: src/idasen_companion/core/logmsg.py
#, python-format
msgctxt "activity-log.entry"
msgid ""
"Move to %(target)s interrupted at %(actual)s; returning to %(return_to)s."
msgstr ""
"Movimiento a %(target)s interrumpido en %(actual)s; volviendo a "
"%(return_to)s."

#: src/idasen_companion/core/logmsg.py
#, python-format
msgctxt "activity-log.entry"
msgid "Now %(current)s (%(height)s) after manual move."
msgstr "Ahora %(current)s (%(height)s) tras el movimiento manual."

#: src/idasen_companion/core/logmsg.py
msgctxt "activity-log.entry"
msgid "Movement stopped by user."
msgstr "Movimiento detenido por el usuario."

#: src/idasen_companion/core/logmsg.py
msgctxt "activity-log.entry"
msgid "Repeat gesture: reversing to the start position."
msgstr "Gesto repetido: volviendo a la posición inicial."

#: src/idasen_companion/core/logmsg.py
msgctxt "activity-log.entry"
msgid "Repeat gesture: stopping the move."
msgstr "Gesto repetido: deteniendo el movimiento."

#: src/idasen_companion/core/logmsg.py
msgctxt "activity-log.entry"
msgid "Scanning for nearby desks..."
msgstr "Buscando escritorios cercanos..."

#: src/idasen_companion/core/logmsg.py
#, python-format
msgctxt "activity-log.entry"
msgid "Bluetooth scan failed: %(error)s"
msgstr "Error en la búsqueda por Bluetooth: %(error)s"

#: src/idasen_companion/core/logmsg.py
#, python-format
msgctxt "activity-log.entry"
msgid "Scan finished: %(count)s device found."
msgid_plural "Scan finished: %(count)s devices found."
msgstr[0] "Escaneo finalizado: %(count)s dispositivo encontrado."
msgstr[1] "Escaneo finalizado: %(count)s dispositivos encontrados."

#: src/idasen_companion/core/logmsg.py
#, python-format
msgctxt "activity-log.entry"
msgid ""
"The desk is connected but unreachable from here, and another companion "
"daemon is running (pid %(pids)s) — most likely another user's session still "
"has the desk. Leaving its connection alone."
msgstr ""
"El escritorio está conectado pero no se puede acceder a él desde aquí, y hay "
"otro servicio de la aplicación en ejecución (pid %(pids)s): lo más probable "
"es que la sesión de otro usuario siga teniendo el escritorio. Se deja su "
"conexión en paz."

#: src/idasen_companion/core/logmsg.py
#, python-format
msgctxt "activity-log.entry"
msgid "Preset '%(name)s' saved at %(height)s."
msgstr "Preajuste «%(name)s» guardado a %(height)s."

#: src/idasen_companion/core/logmsg.py
#, python-format
msgctxt "activity-log.entry"
msgid "Preset '%(name)s' deleted."
msgstr "Preajuste «%(name)s» eliminado."

#: src/idasen_companion/core/logmsg.py
#, python-format
msgctxt "activity-log.entry"
msgid "Preset '%(old)s' renamed to '%(new)s'."
msgstr "Preajuste «%(old)s» renombrado a «%(new)s»."

#: src/idasen_companion/core/logmsg.py
msgctxt "activity-log.entry"
msgid "Autostart enabled: the daemon will start at login."
msgstr ""
"Inicio automático activado: el servicio se iniciará al entrar en la sesión."

#: src/idasen_companion/core/logmsg.py
msgctxt "activity-log.entry"
msgid "Autostart disabled: the daemon will not start at login."
msgstr ""
"Inicio automático desactivado: el servicio no se iniciará al entrar en la "
"sesión."

#: src/idasen_companion/core/presentation/register.py
#, python-format
msgctxt "shared.presentation"
msgid "%d hour"
msgid_plural "%d hours"
msgstr[0] "%d hora"
msgstr[1] "%d horas"

#: src/idasen_companion/core/presentation/register.py
#, python-format
msgctxt "shared.presentation"
msgid "%d minute"
msgid_plural "%d minutes"
msgstr[0] "%d minuto"
msgstr[1] "%d minutos"

#: src/idasen_companion/core/presentation/register.py
#, python-format
msgctxt "shared.presentation"
msgid "%d second"
msgid_plural "%d seconds"
msgstr[0] "%d segundo"
msgstr[1] "%d segundos"

#: src/idasen_companion/core/presentation/register.py
#, python-format
msgctxt "shared.presentation"
msgid "%(hours)s %(minutes)s"
msgstr "%(hours)s y %(minutes)s"

#: src/idasen_companion/core/presentation/register.py
#, python-format
msgctxt "shared.presentation"
msgid "%(hours)sh %(minutes)sm"
msgstr "%(hours)s h %(minutes)s min"

#: src/idasen_companion/core/presentation/register.py
#, python-format
msgctxt "shared.presentation"
msgid "%(minutes)sm"
msgstr "%(minutes)s min"

#: src/idasen_companion/core/presentation/register.py
#, python-format
msgctxt "shared.presentation"
msgid "%(minutes)s min"
msgstr "%(minutes)s min"

#: src/idasen_companion/core/presentation/register.py
#, python-format
msgctxt "shared.presentation"
msgid "%(seconds)ss"
msgstr "%(seconds)s s"

#: src/idasen_companion/core/presentation/register.py
#, python-format
msgctxt "shared.presentation"
msgid "%(value)s cm"
msgstr "%(value)s cm"

#: src/idasen_companion/core/presentation/register.py
#, python-format
msgctxt "shared.presentation"
msgid "%(value)s in"
msgstr "%(value)s pulg"

#: src/idasen_companion/core/presentation/register.py
msgctxt "shared.presentation"
msgid "Automation active"
msgstr "Automatización activa"

#: src/idasen_companion/core/presentation/register.py
msgctxt "shared.presentation"
msgid "Last move failed"
msgstr "El último movimiento falló"

#: src/idasen_companion/core/presentation/register.py
msgctxt "shared.presentation"
msgid "Not set up yet — no desk chosen"
msgstr "Sin configurar — no has elegido escritorio"

#: src/idasen_companion/core/presentation/register.py
msgctxt "shared.presentation"
msgid "Automation off"
msgstr "Automatización desactivada"

#: src/idasen_companion/core/presentation/register.py
msgctxt "shared.presentation"
msgid "Paused"
msgstr "En pausa"

#: src/idasen_companion/core/presentation/register.py
msgctxt "shared.presentation"
msgid "Snoozed"
msgstr "Pospuesto"

#: src/idasen_companion/core/presentation/register.py
msgctxt "shared.presentation"
msgid "Waiting — you seem to be away"
msgstr "Esperando — parece que no estás"

#: src/idasen_companion/core/presentation/register.py
msgctxt "shared.presentation"
msgid "Waiting — session locked"
msgstr "Esperando — sesión bloqueada"

#: src/idasen_companion/core/presentation/register.py
msgctxt "shared.presentation"
msgid "Waiting — switched to another session"
msgstr "Esperando — cambiaste a otra sesión"

#: src/idasen_companion/core/presentation/register.py
msgctxt "shared.presentation"
msgid "On hold — no desktop session"
msgstr "En espera — sin sesión de escritorio"

#: src/idasen_companion/core/presentation/register.py
msgctxt "shared.presentation"
msgid "Outside scheduled hours"
msgstr "Fuera del horario programado"

#: src/idasen_companion/core/presentation/register.py
msgctxt "shared.presentation"
msgid "Paused — desk moved off sit/stand"
msgstr "En pausa — escritorio movido fuera de sentado/de pie"

#: src/idasen_companion/core/presentation/register.py
msgctxt "shared.presentation"
msgid "Active"
msgstr "Activa"

#: src/idasen_companion/core/presentation/register.py
msgctxt "shared.presentation"
msgid "You're away"
msgstr "No estás"

#: src/idasen_companion/core/presentation/register.py
msgctxt "shared.presentation"
msgid "In another session"
msgstr "En otra sesión"

#: src/idasen_companion/core/presentation/register.py
msgctxt "shared.presentation"
msgid "Session locked"
msgstr "Sesión bloqueada"

#: src/idasen_companion/core/presentation/register.py
msgctxt "shared.presentation"
msgid "Outside schedule"
msgstr "Fuera del horario"

#: src/idasen_companion/core/presentation/register.py
msgctxt "shared.presentation"
msgid "Off-cycle"
msgstr "Fuera de ciclo"

#: src/idasen_companion/core/presentation/register.py
#, python-format
msgctxt "shared.presentation"
msgid "Standing up in about %s"
msgstr "De pie en aproximadamente %s"

#: src/idasen_companion/core/presentation/register.py
#, python-format
