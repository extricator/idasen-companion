msgstr "Configuración de Idasen Companion"

#: src/idasen_companion/gui/setup_wizard.py
msgctxt "setup"
msgid "It will move the desk between sit and stand while you work."
msgstr "Moverá el escritorio entre sentado y de pie mientras trabajas."

#: src/idasen_companion/gui/setup_wizard.py
msgctxt "setup"
msgid ""
"Automation is off — the desk will only move when you ask it to. You can turn "
"it on any time in Settings."
msgstr ""
"La automatización está desactivada: el escritorio solo se moverá cuando se "
"lo pidas. Puedes activarla cuando quieras en Configuración."

