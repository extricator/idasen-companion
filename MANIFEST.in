include README.md
# `license-files` in pyproject.toml already puts LICENSE in the sdist and the
# wheel; named here too so it is visible alongside the other root files.
include LICENSE
include MANIFEST.in
# The release notes are a root-level file, so nothing else here sweeps them
# in, and the version-sync test now reads them as text — the same reason the
# spec files and the scripts below are named individually. Leave the line out
# and the RPM's %check, which runs the suite from an unpacked sdist, dies at
# collection while every local run passes.
include CHANGELOG.md
# A root-level file, named here for the same reason as CHANGELOG.md above:
# the new hook test reads its text after the sdist is unpacked.
include CONTRIBUTING.md
# Name the files that ship, rather than sweeping the directory. MANIFEST.in
# reads the *filesystem*, not git, so an unbounded sweep of this directory
# would silently publish whatever happened to be sitting there. An allowlist
# fails safe: new working material stays out until someone adds it on purpose.
include data/icons/io.github.extricator.IdasenCompanion-symbolic.svg
include data/icons/io.github.extricator.IdasenCompanion.svg
include data/idasen-companion.service
include data/io.github.extricator.IdasenCompanion.desktop
include data/io.github.extricator.IdasenCompanion.metainfo.xml
# The sandboxed package's own build consumes the sdist as its source and
# installs the session-activation unit below from inside it — omit this line
# and that install step has nothing to install.
include data/io.github.extricator.IdasenCompanion.service
# Name the docs that ship, rather than sweeping the directory. MANIFEST.in
# reads the *filesystem*, not git, so `recursive-include docs *` silently
# published whatever happened to be sitting there — untracked handoff notes and
# an untracked design-tool export whose screenshots were ~90% of the tarball.
# An allowlist fails safe: new working material stays out until someone adds it
# on purpose. MANUAL-TESTING.md is required (the spec installs it as %doc);
# TRANSLATING.md is here for packagers and contributors.
include docs/MANUAL-TESTING.md
include docs/TRANSLATING.md
include docs/LOGGING.md
# Same reasoning as data/ above: name the spec files that ship instead of
# sweeping the directory. An allowlist bounds itself by construction, which
# retires the pre-emptive Flatpak-scratch exclusion an unbounded sweep used
# to need.
include packaging/idasen-companion-bundled.spec
# The self-contained build installs these out of the unpacked tarball — the
# entry point it puts in place of a generated console script, and a license
# text for each component that ships inside the package without one of its own:
# Qt, whose wheel carries none, and the eight C libraries linked into the
# bundled interpreter, whose tarball carries none either. Leave a line out and
# rpmbuild fails partway through, while every local build passes because the
# files are sitting right there in the working tree. A packaging test also
# reads this directory back, so a text absent from the sdist fails collection
# in the RPM's own suite run.
include packaging/idasen-companion-launcher.sh
include packaging/licenses/LICENSE.LGPL-3.0.txt
include packaging/licenses/LICENSE.Apache-2.0.txt
include packaging/licenses/LICENSE.OpenSSL.txt
include packaging/licenses/LICENSE.X11.txt
include packaging/licenses/LICENSE.Sleepycat.txt
include packaging/licenses/LICENSE.BSD-2-Clause.txt
include packaging/licenses/LICENSE.0BSD.txt
include packaging/licenses/LICENSE.Zlib.txt
include packaging/licenses/LICENSE.bzip2-1.0.6.txt
include packaging/idasen-companion.spec
include packaging/python-bleak.spec
include packaging/python-idasen.spec
# The sandboxed-package build manifest needs to ship too, for the same
# reason as the spec files above: a version-sync check and the RPM's %check
# both read it as text after the sdist is unpacked.
include packaging/flatpak/io.github.extricator.IdasenCompanion.yaml
# The packaging suite audits the generated offline dependency lock from an
# unpacked sdist during the bundled RPM build.
include packaging/flatpak/python3-deps.json
# A packaging test reads three of the new .deb build-metadata files as text
# after the sdist is unpacked, so they must ship the same way the two app
# spec files above do — named individually, not swept in with everything
# else the new build metadata added.
include debian/control
include debian/rules
include debian/changelog
include debian/idasen-companion.install
include debian/idasen-companion-headless.install
include debian/idasen-companion.user.service
include debian/idasen-companion-headless.idasen-companion.user.service
recursive-include tests *.py
# Same reasoning as the naming checker and the pre-commit hook further down:
# the suite ships whole and the RPM's %check runs it from an unpacked
# tarball, so a data file a test opens has to travel with it too, or that
# test dies at collection with FileNotFoundError while every local run
# passes, because the file is sitting right there in the working tree.
include tests/goldens/vocabulary_en.json
include tests/goldens/vocabulary_es.json
# The window before-picture's two goldens, for the same reason as the pair
# above: a data file a test opens has to ship with the suite that opens it.
include tests/goldens/window_en.json
include tests/goldens/window_es.json
# Translations: live gettext sources/compiled catalog plus frozen inactive
# .ts/.qm migration evidence retained until Phase 7. See docs/TRANSLATING.md.
include scripts/build-translations.sh
include scripts/migrate-contextual-gettext.py
include scripts/build-dist.sh
include scripts/build-release-variants.sh
include scripts/verify-release-artifacts.sh
# The suite ships whole (recursive-include tests above) and the RPM's %check
# runs it from an unpacked sdist, so every script a test reads must ship too.
# tests/test_naming_span.py imports this one; without it %check dies at
# collection with FileNotFoundError, which no local run reproduces because the
# file is sitting right there in the working tree.
include scripts/check_naming_span.py
# Same reasoning as the naming checker just above: the suite ships whole and
# the RPM's %check runs it from an unpacked tarball, so anything a test opens
# has to travel with it too. A missing line here fails only in a package
# build, never in a local run, because the file sits right there in the
# working tree the whole time.
include .githooks/pre-commit
include scripts/scan-secrets.sh
# The first of these ships for a different reason than everything above: no
# test reads it. The bundled spec invokes the Qt trimmer from %install, out of
# the unpacked tarball, so leaving it out breaks the package build itself
# rather than the suite. The runtime fetcher has both reasons — it is what
# makes the sdist enough to build the package from, since it produces the wheel
# tarball the spec takes as its second source and a contributor who has only
# the sdist would otherwise have no way to obtain it, and the suite reads its
# pin list to hold the spec's declarations against it.
include scripts/trim-pyside6.py
# The interpreter trim below has both reasons at once: the bundled spec runs it
# from %install out of the unpacked tarball, and the suite loads it by path to
# read its removal list. Omit the line and the package build breaks in one
# place while %check dies at collection in the other — and every local run
# still passes, because the file is sitting right there in the working tree.
include scripts/trim-cpython.py
include scripts/fetch-bundled-runtime.sh
# The strip pass %install runs by hand, out of the unpacked tarball like the
# two trimmers above, for the same reason and with the same consequence for
# leaving the line out.
include scripts/strip-bundled-tree.sh
# The linkage and symbol-version assertions, run from %check out of the
# unpacked tarball like the two trimmers above. Omit the line and the package
# build stops in the middle of %check, while every local build passes, because
# the file is sitting right there in the working tree.
include scripts/verify-bundled-elf.sh
# The bytecode assertions, run from %check out of the unpacked tarball for the
# same reason and with the same consequence for leaving the line out.
include scripts/verify-bundled-bytecode.sh
# The cross-distribution proof. Nothing in a package build runs it — it needs
# a finished package and a container runtime — but the suite now reads the
# statistics probe it carries, and the suite ships whole and runs from an
# unpacked tarball. Omit the line and %check dies at collection while every
# local run passes, because the file is sitting right there in the working
# tree.
include scripts/verify-rpm-portability.sh
recursive-include translations *.ts
recursive-include po *.po *.pot
recursive-include src/idasen_companion/gui/translations *.qm
recursive-include src/idasen_companion/locale *.mo
